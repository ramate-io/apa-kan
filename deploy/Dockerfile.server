FROM rust:1.95-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p apa-kan-server --features sqlite,postgres

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/apa-kan-server /usr/local/bin/apa-kan-server
ENV PORT=8080
EXPOSE 8080
CMD ["apa-kan-server"]
