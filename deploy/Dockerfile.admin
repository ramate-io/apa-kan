FROM rust:1.95-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p apa-kan-admin

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/apa-kan-admin /usr/local/bin/apa-kan-admin
ENV ADMIN_PORT=3000
EXPOSE 3000
CMD ["apa-kan-admin"]
